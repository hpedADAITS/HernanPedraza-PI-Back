# Backend Environment Configuration
# Copy to .env.local for development or set on deployment platform

NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Local: mongodb://localhost:27017/Syncrequest
# Remote: mongodb+srv://user:pass@cluster.mongodb.net/Syncrequest?retryWrites=true
MONGODB_URI=mongodb://localhost:27017/Syncrequest
DB_NAME=Syncrequest

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
DEBUG_EMAIL=false

# Socket.IO Options
SOCKET_AUTH_DISABLED=false
